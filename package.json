{
  "name": "blaksync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "blaksync": "cargo run --quiet --",
    "gui": "cargo run --quiet -- gui",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "cargo test --all-targets --all-features"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
